<div class="max-w-7xl mx-auto px-4 py-6 space-y-8">
  <!-- Month Navigation -->
  <div class="flex items-center justify-between">
    <%= link_to "← Previous",
    authenticated_root_path(year: (@month - 1.month).year, month: (@month - 1.month).month),
    class: "text-sm text-gray-600 hover:text-gray-900" %>

    <h1 class="text-2xl font-semibold text-gray-900">
      <%= @month.strftime("%B %Y") %>
    </h1>

    <% if @month < Date.current.beginning_of_month %>
      <%= link_to "Next →",
      authenticated_root_path(year: (@month + 1.month).year, month: (@month + 1.month).month),
      class: "text-sm text-gray-600 hover:text-gray-900" %>
    <% else %>
      <span class="text-sm text-gray-400">Next →</span>
    <% end %>
  </div>
  <!-- Summary Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <%= link_to transactions_path(
      year: @month.year,
      month: @month.month,
      type: "income"
    ),
    class: "block bg-white rounded-xl shadow p-4 hover:bg-gray-50 transition" do %>

      <p class="text-sm text-gray-500">Income</p>
      <p class="text-xl font-semibold text-green-600">
        <%= number_to_currency(@income) %>
      </p>

    <% end %>

    <%= link_to transactions_path(
      year: @month.year,
      month: @month.month,
      type: "expenses"
    ),
    class: "block bg-white rounded-xl shadow p-4 hover:bg-gray-50 transition" do %>

      <p class="text-sm text-gray-500">Expenses</p>
      <p class="text-xl font-semibold text-red-600">
        <%= number_to_currency(@expenses) %>
      </p>

    <% end %>

    <div class="bg-white rounded-xl shadow p-4">
      <p class="text-sm text-gray-500">Net</p>
      <p
        class="text-xl font-semibold <%= @net >= 0 ? 'text-green-600' : 'text-red-600' %>"
      >
        <%= number_to_currency(@net) %>
      </p>
    </div>

    <div class="bg-white rounded-xl shadow p-4">
      <p class="text-sm text-gray-500">
        Avg Daily Spend
      </p>
      <p class="text-xl font-semibold text-gray-900">
        <%= number_to_currency(@avg_daily) %>
      </p>
    </div>
  </div>
  <!-- Largest Expenses -->
  <div class="bg-white rounded-xl shadow p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">
      Largest Expenses
    </h2>

    <% if @largest_expenses.any? %>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-gray-500 border-b">
            <th class="pb-2">Date</th>
            <th>Description</th>
            <th class="text-right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% @largest_expenses.each do |tx| %>
            <tr class="border-b last:border-0">
              <td class="py-2 text-gray-600">
                <%= tx.transaction_date.strftime("%b %d") %>
              </td>
              <td class="py-2">
                <%= tx.description %>
              </td>
              <td class="py-2 text-right text-red-600 font-medium">
                <%= number_to_currency(tx.amount) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-gray-500">
        No expenses for this month.
      </p>
    <% end %>
    <!-- View More -->
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-medium text-gray-900">
        Largest Expenses
      </h2>

      <%= link_to "View all →",
      transactions_path(year: @month.year, month: @month.month),
      class: "text-sm text-blue-600 hover:text-blue-800" %>
    </div>
  </div>
  <!-- Category Breakdown -->
  <div class="bg-white rounded-xl shadow p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">
      Expenses by Category
    </h2>

    <% if @by_category.any? %>
      <div class="flex gap-6">
        <div class="flex-1" data-controller="pie-chart" data-pie-chart-data-value="<%= { labels: @by_category.keys.reject { |k| k.end_with?("_color", "_icon") }, values: @by_category.select { |k, _| !k.end_with?("_color", "_icon") }.values.map { |v| v.abs } }.to_json %>">
          <div class="max-h-80 p-5">
            <canvas></canvas>
          </div>
        </div>
        <div class="flex-1">
          <ul class="space-y-2" id="category-list">
            <% @by_category.each do |key, value| %>
              <% next if key.end_with?("_color", "_icon") %>
              <% category = key %>
              <% color = @by_category["#{key}_color"] %>
              <% icon = @by_category["#{key}_icon"] %>
              <li data-category="<%= category %>">
                <%= link_to transactions_path(year: @month.year, month: @month.month, category: category), class: "text-gray-700 hover:text-blue-600 hover:underline text-sm" do %>
                  <% if color %>
                    <span class="inline-block h-2.5 w-2.5 rounded-full mr-1 align-middle" style="background-color: <%= color %>"></span>
                  <% end %>
                  <% if icon.present? %>
                    <span class="mr-1"><%= icon %></span>
                  <% end %>
                  <%= category %>
                <% end %>
                <span class="text-gray-900 font-medium text-sm float-right">
                  <%= number_to_currency(value.abs) %>
                </span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">
        No categorized expenses.
      </p>
    <% end %>
  </div>

</div>

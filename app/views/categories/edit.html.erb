<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Category</h1>

  <%= form_with model: @category, url: category_path(@category), local: true, class: "space-y-6 bg-white p-6 rounded-lg shadow" do |f| %>
    <% if @category.errors.any? %>
      <div class="bg-red-50 border-l-4 border-red-400 p-4">
        <p class="text-sm text-red-700"><%= @category.errors.full_messages.join(", ") %></p>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Name", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :color, "Color (hex)", class: "block text-sm font-medium text-gray-700" %>
        <div class="mt-1 flex items-center space-x-2">
          <input type="color" name="category[color]" id="colorPicker" class="h-9 w-16 rounded border border-gray-300" value="<%= @category.color || '#6366F1' %>">
          <span class="text-sm text-gray-500">Optional</span>
        </div>
      </div>
      <div>
        <%= f.label :icon, "Icon (emoji)", class: "block text-sm font-medium text-gray-700" %>
        <div class="mt-1 relative" data-controller="emoji-picker">
          <div class="flex rounded-md shadow-sm">
            <%= f.text_field :icon,
                data: { "emoji-picker-target": "input" },
                class: "flex-1 block w-full rounded-l-md border-gray-300 focus:ring-blue-500 focus:border-blue-500 sm:text-sm",
                placeholder: "Select emoji",
                maxlength: 1 %>
            <button type="button"
                    data-action="emoji-picker#toggle"
                    data-emoji-picker-target="trigger"
                    class="inline-flex items-center px-3 rounded-r-md border border-l-0 border-gray-300 bg-gray-50 text-gray-500 sm:text-sm hover:bg-gray-100">
              😀
            </button>
          </div>
          <div data-emoji-picker-target="pickerContainer" class="hidden absolute z-10 mt-1">
          </div>
        </div>
      </div>
    </div>

    <div>
      <%= f.label :category_group, "Category Group", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :category_group, options_for_select(Category.category_groups.keys.map { |g| [g.humanize, g] }, @category.category_group), { include_blank: "Select a group" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
    </div>
    </div>

    <div class="flex justify-between">
      <%= link_to "Cancel", categories_path, class: "text-gray-700 hover:text-gray-900" %>
      <%= f.submit "Update Category", class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    </div>
  <% end %>
</div>

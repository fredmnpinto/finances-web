<div class="max-w-7xl mx-auto px-4 py-6 space-y-8">
  <!-- Month Navigation -->
  <div class="flex items-center justify-between">
    <%= link_to "← Previous",
    root_path(year: (@month - 1.month).year, month: (@month - 1.month).month),
    class: "text-sm text-gray-600 hover:text-gray-900" %>

    <h1 class="text-2xl font-semibold text-gray-900">
      <%= @month.strftime("%B %Y") %>
    </h1>

    <% if @month < Date.current.beginning_of_month %>
      <%= link_to "Next →",
      root_path(year: (@month + 1.month).year, month: (@month + 1.month).month),
      class: "text-sm text-gray-600 hover:text-gray-900" %>
    <% else %>
      <span class="text-sm text-gray-400">Next →</span>
    <% end %>
  </div>
  <!-- Summary Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white rounded-xl shadow p-4">
      <p class="text-sm text-gray-500">Income</p>
      <p class="text-xl font-semibold text-green-600">
        <%= number_to_currency(@income) %>
      </p>
    </div>

    <div class="bg-white rounded-xl shadow p-4">
      <p class="text-sm text-gray-500">Expenses</p>
      <p class="text-xl font-semibold text-red-600">
        <%= number_to_currency(@expenses) %>
      </p>
    </div>

    <div class="bg-white rounded-xl shadow p-4">
      <p class="text-sm text-gray-500">Net</p>
      <p
        class="text-xl font-semibold <%= @net >= 0 ? 'text-green-600' : 'text-red-600' %>"
      >
        <%= number_to_currency(@net) %>
      </p>
    </div>

    <div class="bg-white rounded-xl shadow p-4">
      <p class="text-sm text-gray-500">
        Avg Daily Spend
      </p>
      <p class="text-xl font-semibold text-gray-900">
        <%= number_to_currency(@avg_daily) %>
      </p>
    </div>
  </div>
  <!-- Largest Expenses -->
  <div class="bg-white rounded-xl shadow p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">
      Largest Expenses
    </h2>

    <% if @largest_expenses.any? %>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-gray-500 border-b">
            <th class="pb-2">Date</th>
            <th>Description</th>
            <th class="text-right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% @largest_expenses.each do |tx| %>
            <tr class="border-b last:border-0">
              <td class="py-2 text-gray-600">
                <%= tx.date.strftime("%b %d") %>
              </td>
              <td class="py-2">
                <%= tx.description %>
              </td>
              <td class="py-2 text-right text-red-600 font-medium">
                <%= number_to_currency(tx.amount) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-gray-500">
        No expenses for this month.
      </p>
    <% end %>
  </div>
  <!-- Category Breakdown -->
  <div class="bg-white rounded-xl shadow p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">
      Expenses by Category
    </h2>

    <% if @by_category.any? %>
      <ul class="space-y-3">
        <% @by_category.each do |category, amount| %>
          <% pct = @expenses.zero? ? 0 : (amount.abs / @expenses * 100).round %>

          <li>
            <div class="flex justify-between text-sm">
              <span class="text-gray-700">
                <%= category %>
              </span>
              <span class="text-gray-900 font-medium">
                <%= number_to_currency(amount.abs) %>
              </span>
            </div>

            <div class="w-full bg-gray-200 rounded-full h-2 mt-1">
              <div class="h-2 rounded-full bg-blue-500" style="width: <%= pct %>%">
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-500">
        No categorized expenses.
      </p>
    <% end %>
  </div>

</div>

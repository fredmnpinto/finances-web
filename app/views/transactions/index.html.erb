<div class="max-w-7xl mx-auto px-4 py-6 space-y-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">
      Transactions —
      <%= @month.strftime("%B %Y") %>
    </h1>

    <%= link_to "← Back to dashboard",
    dashboard_path(year: @month.year, month: @month.month),
    class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>
  <!-- Table Filters -->
  <div class="bg-white rounded-xl shadow p-4">
    <%= form_with url: transactions_path, method: :get, local: true, class: "grid grid-cols-1 sm:grid-cols-4 gap-4" do %>

      <%= hidden_field_tag :year, @month.year %>
      <%= hidden_field_tag :month, @month.month %>
      <!-- Search -->
      <div>
        <label class="block text-sm text-gray-600 mb-1">
          Search
        </label>
        <%= text_field_tag :q,
        params[:q],
        placeholder: "Description contains…",
        class: "w-full rounded-md border-gray-300 text-sm" %>
      </div>
      <!-- Category -->
      <div>
        <label class="block text-sm text-gray-600 mb-1">
          Category
        </label>
        <%= select_tag :category,
        options_for_select(@categories, params[:category]),
        include_blank: "All categories",
        class: "w-full rounded-md border-gray-300 text-sm" %>
      </div>
      <!-- Amount Type -->
      <div>
        <label class="block text-sm text-gray-600 mb-1">
          Transaction Type
        </label>
        <%= select_tag :type,
        options_for_select(
          [["All", nil]] + @transaction_types.map { |tt| [tt.titleize, tt] },
          params[:type],
        ),
        class: "w-full rounded-md border-gray-300 text-sm" %>
      </div>
      <!-- Actions -->
      <div class="flex items-end gap-2">
        <%= submit_tag "Filter",
        class: "px-4 py-2 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700" %>

        <%= link_to "Reset",
        transactions_path(year: @month.year, month: @month.month),
        class: "text-sm text-gray-600 hover:text-gray-900" %>
      </div>

    <% end %>
  </div>
  <!-- Transactions Table -->
  <div class="bg-white rounded-xl shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50">
        <tr class="text-left text-gray-500">
          <th class="px-4 py-3">Date</th>
          <th class="px-4 py-3">Description</th>
          <th class="px-4 py-3">Category</th>
          <th class="px-4 py-3 text-right">Amount</th>
        </tr>
      </thead>

      <tbody>
        <% @transactions.each do |tx| %>
          <tr class="border-t last:border-b">
            <td class="px-4 py-3 text-gray-600">
              <%= tx.date.strftime("%Y-%m-%d") %>
            </td>

            <td class="px-4 py-3">
              <%= tx.description %>
            </td>

            <td class="px-4 py-3 text-gray-700">
              <%= tx.confirmed_category || tx.suggested_category || "Uncategorized" %>
            </td>

            <td
              class="
                px-4 py-3 text-right font-medium <%= tx.amount < 0 ? 'text-red-600' : 'text-green-600' %>
              "
            >
              <%= number_to_currency(tx.amount) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

</div>

<div class="max-w-7xl mx-auto px-4 py-6 space-y-6" data-controller="transaction-bulk">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">
      Transactions —
      <%= @month.strftime("%B %Y") %>
    </h1>

    <div class="flex items-center gap-4">
      <%= button_to "Confirm all suggested",
      confirm_all_suggested_transactions_path(year: @month.year, month: @month.month),
      class: "px-3 py-1.5 text-sm bg-green-600 text-white rounded-md hover:bg-green-700" %>

      <%= link_to "← Back to dashboard",
      dashboard_path(year: @month.year, month: @month.month),
      class: "text-sm text-gray-600 hover:text-gray-900" %>
    </div>
  </div>

  <!-- Table Filters -->
  <div class="bg-white rounded-xl shadow p-4">
    <%= form_with url: transactions_path, method: :get, local: true, class: "grid grid-cols-1 sm:grid-cols-5 gap-4" do %>

      <%= hidden_field_tag :year, @month.year %>
      <%= hidden_field_tag :month, @month.month %>
      <!-- Search -->
      <div>
        <label class="block text-sm text-gray-600 mb-1">
          Search
        </label>
        <%= text_field_tag :q,
        params[:q],
        placeholder: "Description contains…",
        class: "w-full rounded-md border-gray-300 text-sm" %>
      </div>
      <!-- Category -->
      <div>
        <label class="block text-sm text-gray-600 mb-1">
          Category
        </label>
        <%= select_tag :category,
        options_for_select(@categories.map { |c| [c.name, c.name] }, params[:category]),
        include_blank: "All categories",
        class: "w-full rounded-md border-gray-300 text-sm" %>
      </div>
      <!-- Amount Type -->
      <div>
        <label class="block text-sm text-gray-600 mb-1">
          Transaction Type
        </label>
        <%= select_tag :type,
        options_for_select(
          [["All", nil]] + @transaction_types.map { |tt| [tt.titleize, tt] },
          params[:type],
        ),
        class: "w-full rounded-md border-gray-300 text-sm" %>
      </div>
      <!-- Status Filter -->
      <div>
        <label class="block text-sm text-gray-600 mb-1">
          Status
        </label>
        <%= select_tag :category_confirmation_filter,
        options_for_select(
          [["Unconfirmed", "unconfirmed"], ["Confirmed", "confirmed"], ["All", "all"]],
          @category_confirmation_filter
        ),
        class: "w-full rounded-md border-gray-300 text-sm" %>
      </div>
      <!-- Actions -->
      <div class="flex items-end gap-2">
        <%= submit_tag "Filter",
        class: "px-4 py-2 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700" %>

        <%= link_to "Reset",
        transactions_path(year: @month.year, month: @month.month),
        class: "text-sm text-gray-600 hover:text-gray-900" %>
      </div>

    <% end %>
  </div>

  <!-- Bulk Actions Toolbar -->
  <div id="bulk-toolbar" data-transaction-bulk-target="toolbar" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 bg-gray-900 text-white px-6 py-3 rounded-lg shadow-lg flex items-center gap-4 z-50">
    <span data-transaction-bulk-target="count" class="font-medium">0</span>
    <span class="text-gray-400">selected</span>
    <div class="w-px h-6 bg-gray-700"></div>

    <%= select_tag "bulk_category_id",
    options_for_select(@categories.map { |c| ["#{c.icon.present? ? c.icon + ' ' : ''}#{c.name}", c.id] }),
    include_blank: "Select category…",
    id: "bulk-category-select",
    class: "rounded-md border-0 bg-gray-800 text-sm text-white" %>

    <button type="button"
            data-action="click->transaction-bulk#bulkUpdateSelected"
            class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700">
      Update
    </button>

    <button type="button"
            data-action="click->transaction-bulk#confirmSelected"
            class="px-3 py-1.5 bg-green-600 text-white text-sm rounded-md hover:bg-green-700">
      Confirm as Suggested
    </button>

    <button type="button"
            data-action="click->transaction-bulk#deleteSelected"
            class="px-3 py-1.5 bg-red-600 text-white text-sm rounded-md hover:bg-red-700">
      Delete
    </button>
  </div>

  <!-- Transactions Table -->
  <div class="bg-white rounded-xl shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50">
        <tr class="text-left text-gray-500">
          <th class="px-4 py-3 w-10">
            <input type="checkbox"
                   data-transaction-bulk-target="selectAll"
                   data-action="change->transaction-bulk#toggleSelectAll"
                   class="rounded border-gray-300">
          </th>
          <th class="px-4 py-3">Date</th>
          <th class="px-4 py-3">Description</th>
          <th class="px-4 py-3">Category</th>
          <th class="px-4 py-3 text-right">Amount</th>
          <th class="px-4 py-3 w-24"></th>
        </tr>
      </thead>

      <tbody>
        <% @transactions.each do |tx| %>
          <tr class="border-t last:border-b cursor-pointer hover:bg-gray-50"
              data-transaction-id="<%= tx.id %>"
              data-transaction-bulk-target="row"
              data-action="click->transaction-bulk#toggleSelect">
            <td class="px-4 py-3" data-action="click->transaction-bulk#toggleSelect">
              <input type="checkbox"
                     class="rounded border-gray-300">
            </td>
            <td class="px-4 py-3 text-gray-600">
              <%= tx.date.strftime("%Y-%m-%d") %>
            </td>

            <td class="px-4 py-3">
              <%= tx.description %>
            </td>

            <td class="px-4 py-3">
              <% if tx.category %>
                <% emoji = case tx.category.category_group
                  when 'needs' then '🛒'
                  when 'wants' then '🎯'
                  when 'savings' then '📊'
                  when 'income' then '💰'
                  end %>
                <span class="inline-flex items-center gap-1.5 group" title="<%= tx.category.category_group.to_s.titleize %>">
                  <% if tx.category.color %>
                    <span class="h-2.5 w-2.5 rounded-full" style="background-color: <%= tx.category.color %>"></span>
                  <% end %>
                  <% if tx.category.icon.present? %>
                    <span><%= tx.category.icon %></span>
                  <% end %>
                  <span class="cursor-help" title="<%= tx.category.category_group.to_s.titleize %>"><%= emoji %></span>
                  <span class="<%= tx.category.income? || tx.category.savings? ? 'text-green-700' : 'text-red-700' %>"><%= tx.category.name %></span>
                </span>
              <% elsif tx.suggested_category %>
                <% emoji = case tx.suggested_category.category_group
                  when 'needs' then '🛒'
                  when 'wants' then '🎯'
                  when 'savings' then '📊'
                  when 'income' then '💰'
                  end %>
                <div class="flex items-center gap-1.5 group" title="<%= tx.suggested_category.category_group.to_s.titleize %>">
                  <% if tx.suggested_category.color %>
                    <span class="h-2.5 w-2.5 rounded-full opacity-50" style="background-color: <%= tx.suggested_category.color %>"></span>
                  <% end %>
                  <% if tx.suggested_category.icon.present? %>
                    <span class="opacity-50"><%= tx.suggested_category.icon %></span>
                  <% end %>
                  <span class="cursor-help" title="<%= tx.suggested_category.category_group.to_s.titleize %>"><%= emoji %></span>
                  <span class="<%= tx.suggested_category.income? || tx.suggested_category.savings? ? 'text-green-700' : 'text-red-700' %>"><%= tx.suggested_category.name %></span>
                  <span class="text-xs text-gray-400">(suggested)</span>
                </div>
              <% else %>
                <span class="text-gray-400 italic">Uncategorized</span>
              <% end %>
            </td>

            <td
              class="
                px-4 py-3 text-right font-medium <%= tx.amount < 0 ? 'text-red-600' : 'text-green-600' %>
              "
            >
              <%= number_to_currency(tx.amount) %>
            </td>

            <td class="px-4 py-3">
              <% unless tx.category || tx.suggested_category.nil? %>
                <%= button_to "Confirm",
                confirm_category_transaction_path(tx, return_params),
                method: :patch,
                class: "text-xs text-green-600 hover:text-green-800",
                data: { confirm: "Confirm '#{tx.suggested_category.name}'?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

</div>

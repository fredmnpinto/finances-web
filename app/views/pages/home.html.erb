<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center">
  <div class="container mx-auto px-4 py-16 max-w-6xl">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6">
        Finances <span class="text-blue-600">Web</span>
      </h1>
      <p class="text-xl md:text-2xl text-gray-600 mb-10 max-w-3xl mx-auto leading-relaxed">
        Take control of your personal finances with powerful tracking, insightful analytics, and secure data management.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <%= link_to "Get Started", new_user_registration_path, 
            class: "inline-block bg-blue-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-blue-700 transition duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-1" %>
        <%= link_to "Sign In", new_user_session_path,
            class: "inline-block bg-white text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-gray-50 transition duration-200 shadow-lg hover:shadow-xl border border-blue-200 transform hover:-translate-y-1" %>
      </div>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow duration-300">
        <div class="text-blue-600 text-4xl mb-4">📊</div>
        <h3 class="text-xl font-semibold mb-3 text-gray-900">Track Everything</h3>
        <p class="text-gray-600 leading-relaxed">Monitor income, expenses, and savings with intuitive categorization and powerful filtering.</p>
      </div>
      
      <div class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow duration-300">
        <div class="text-green-600 text-4xl mb-4">🔒</div>
        <h3 class="text-xl font-semibold mb-3 text-gray-900">Secure & Private</h3>
        <p class="text-gray-600 leading-relaxed">Your financial data is encrypted and protected with enterprise-grade security measures.</p>
      </div>
      
      <div class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow duration-300">
        <div class="text-purple-600 text-4xl mb-4">📈</div>
        <h3 class="text-xl font-semibold mb-3 text-gray-900">Smart Insights</h3>
        <p class="text-gray-600 leading-relaxed">Get actionable insights about your spending patterns and financial health.</p>
      </div>
    </div>
  </div>
</div>
